CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=448

# BPI-R4 + BE14 wireless and MediaTek data path
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_kmod-mt7996-firmware-common=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996-233-firmware=y
CONFIG_PACKAGE_mt7988-wo-firmware=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_smp_util=y
CONFIG_PACKAGE_mtkhnat_util=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-flow-netlink=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# LuCI, Argon, and Simplified Chinese
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_LUCI_LANG_zh_Hans=y

# Management and network applications
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_bandix=y
CONFIG_PACKAGE_luci-app-bandix=y
# Keep only the timezone database needed by this Asia-targeted build. The
# zoneinfo-all metapackage otherwise consumes the fixed recovery FIT window.
# CONFIG_PACKAGE_zoneinfo-all is not set
# CONFIG_PACKAGE_zoneinfo-africa is not set
# CONFIG_PACKAGE_zoneinfo-america is not set
CONFIG_PACKAGE_zoneinfo-asia=y
# CONFIG_PACKAGE_zoneinfo-atlantic is not set
# CONFIG_PACKAGE_zoneinfo-australia-nz is not set
# CONFIG_PACKAGE_zoneinfo-europe is not set
# CONFIG_PACKAGE_zoneinfo-indian is not set
# CONFIG_PACKAGE_zoneinfo-pacific is not set
# CONFIG_PACKAGE_zoneinfo-poles is not set
CONFIG_PACKAGE_ip-full=y
# OpenClash is kept in package/custom for optional source builds, but excluded
# from the production image because its privileged updater uses unsafe fixed
# temporary paths. This also avoids pulling Ruby into the router image.
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_RUBY_ENABLE_YJIT is not set
#CONFIG_PACKAGE_luci-app-qmodem-next=y
#CONFIG_PACKAGE_luci-app-mt5700-web=y
#CONFIG_PACKAGE_luci-app-speedtest-x=y
#CONFIG_PACKAGE_luci-app-wan-speedtest=y
CONFIG_PACKAGE_bpi-r4-be14-defaults=y
#CONFIG_PACKAGE_librespeed-cli=y
# CONFIG_PACKAGE_librespeed-cli-rust is not set

# Useful diagnostics (production-safe)
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
# CONFIG_PACKAGE_usbutils is not set

# Keep the full dnsmasq variant for DNSSEC, nftset and diagnostics.
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# Stable release: exclude MediaTek development, test, legacy HNAT and NPU/L4S paths.
# CONFIG_DEVEL is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_PACKAGE_perf is not set
# CONFIG_PACKAGE_mt76-test is not set
# CONFIG_PACKAGE_CFG80211_TESTMODE is not set
# CONFIG_PACKAGE_MAC80211_DEBUGFS is not set
# CONFIG_PACKAGE_atenl is not set
# CONFIG_PACKAGE_quick_track is not set
# CONFIG_PACKAGE_regs is not set
# CONFIG_PACKAGE_kmod-mediatek_hnat is not set
# CONFIG_PACKAGE_kmod-npu is not set
# CONFIG_PACKAGE_kmod-npu-autoload is not set
# CONFIG_PACKAGE_kmod-npu-flow is not set
# CONFIG_PACKAGE_kmod-npu-flow-autoload is not set
# CONFIG_PACKAGE_kmod-pce is not set
# CONFIG_PACKAGE_kmod-pce-autoload is not set
# CONFIG_MTK_NPU_L4S is not set
