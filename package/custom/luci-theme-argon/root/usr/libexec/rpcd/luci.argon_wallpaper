#!/bin/sh
# author jjm2473

umask 077

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

# the script will be excuted when `argon.@global[0].bing_background == '1'`
# defaults to 'bing' to be compatible with old config
WEB_PIC_SRC="$(uci -q get argon.@global[0].online_wallpaper || echo 'bing')"
case "$WEB_PIC_SRC" in
	bing|bing_cn|unsplash|none) ;;
	unsplash_*)
		case "$WEB_PIC_SRC" in
			*[!A-Za-z0-9_-]*) WEB_PIC_SRC='bing' ;;
		esac
		;;
	# Migrate removed Wallhaven selections to the keyless mainland endpoint.
	wallhaven|wallhaven_*) WEB_PIC_SRC='bing_cn' ;;
	*) WEB_PIC_SRC='bing' ;;
esac

# Unsplash Source was retired in 2024. Use the official API when an access key
# is configured and a small curated images.unsplash.com pool otherwise.
UNSPLASH_KEY="$(uci -q get argon.@global[0].unsplash_access_key)"

RUNTIME_DIR="/var/run/luci-argon-wallpaper"
CACHE="${RUNTIME_DIR}/${WEB_PIC_SRC}.url"
WRLOCK="${RUNTIME_DIR}/${WEB_PIC_SRC}.lock"

path_exists() {
	[ -e "$1" ] || [ -L "$1" ]
}

safe_runtime_dir() {
	[ ! -L "$RUNTIME_DIR" ] &&
		[ -d "$RUNTIME_DIR" ] &&
		[ "$(stat -c '%u:%g:%a' "$RUNTIME_DIR" 2>/dev/null)" = 0:0:700 ]
}

safe_cache_file() {
	[ ! -L "$CACHE" ] || return 1
	path_exists "$CACHE" || return 0
	[ -f "$CACHE" ] &&
		[ "$(stat -c '%u:%g:%a:%h' "$CACHE" 2>/dev/null)" = 0:0:600:1 ]
}

safe_lock_file() {
	[ ! -L "$WRLOCK" ] || return 1
	[ -f "$WRLOCK" ] &&
		[ "$(stat -c '%u:%g:%a:%h' "$WRLOCK" 2>/dev/null)" = 0:0:600:1 ]
}

ensure_lock_file() {
	if ! path_exists "$WRLOCK"; then
		# noclobber makes the creation an atomic O_EXCL operation. A losing
		# concurrent request validates the winner's file below instead of
		# opening or replacing an attacker-controlled path.
		( umask 077; set -C; : > "$WRLOCK" ) 2>/dev/null || true
	fi
	safe_lock_file
}

init_runtime() {
	[ ! -L "$RUNTIME_DIR" ] || return 1
	if ! path_exists "$RUNTIME_DIR"; then
		mkdir -m 0700 "$RUNTIME_DIR" 2>/dev/null || safe_runtime_dir || return 1
	fi
	safe_runtime_dir && safe_cache_file && ensure_lock_file
}

acquire_lock() {
	LOCK_OWNED=0
	ensure_lock_file || return 2
	exec 9<> "$WRLOCK" || return 2
	if ! safe_lock_file; then
		exec 9>&-
		return 2
	fi
	if ! flock -n 9 >/dev/null 2>&1; then
		exec 9>&-
		return 1
	fi
	LOCK_OWNED=1
}

release_lock() {
	local release_status=0
	[ "${LOCK_OWNED:-0}" = 1 ] || return 0
	LOCK_OWNED=0
	flock -u 9 >/dev/null 2>&1 || release_status=1
	exec 9>&-
	return "$release_status"
}

replace_cache() {
	local source_file="$1"
	[ ! -L "$source_file" ] &&
		[ -f "$source_file" ] &&
		[ "$(stat -c '%u:%g:%a:%h' "$source_file" 2>/dev/null)" = 0:0:600:1 ] || return 1
	safe_cache_file || return 1
	mv -f "$source_file" "$CACHE" || return 1
	safe_cache_file
}

write_cache() {
	local cache_tmp
	cache_tmp="$(mktemp "$RUNTIME_DIR/.${WEB_PIC_SRC}.url.XXXXXX")" || return 1
	if [ -n "$1" ]; then
		printf '%s\n' "$1" > "$cache_tmp"
	else
		: > "$cache_tmp"
	fi || {
		rm -f "$cache_tmp"
		return 1
	}
	chmod 0600 "$cache_tmp" || {
		rm -f "$cache_tmp"
		return 1
	}
	replace_cache "$cache_tmp" || {
		rm -f "$cache_tmp"
		return 1
	}
}

read_cache() {
	local cached_url
	safe_cache_file && [ -s "$CACHE" ] || return 1
	cached_url="$(cat "$CACHE")" || return 1
	case "$cached_url" in
		*'
'*) return 1 ;;
	esac
	valid_pic_url "$cached_url" || return 1
	printf '%s\n' "$cached_url"
}

cache_age() {
	local mtime now
	safe_cache_file && path_exists "$CACHE" || return 1
	mtime="$(stat -c '%Y' "$CACHE" 2>/dev/null)" || return 1
	now="$(date '+%s')" || return 1
	case "$mtime:$now" in
		*[!0-9:]*) return 1 ;;
	esac
	if [ "$mtime" -gt "$now" ]; then
		printf '0\n'
	else
		printf '%s\n' "$((now - mtime))"
	fi
}

valid_key() {
	case "$1" in
		''|*[!A-Za-z0-9_-]*) return 1 ;;
		*) return 0 ;;
	esac
}

unsplash_fallback() {
	# These are stable Unsplash CDN photo IDs. Rotate every 12 hours so the
	# login page remains useful even without a per-installation API key.
	set -- \
		photo-1500530855697-b586d89ba3ee \
		photo-1470770841072-f978cf4d019e \
		photo-1501785888041-af3ef285b470 \
		photo-1441974231531-c6227db76b6e \
		photo-1464822759023-fed622ff2c3b \
		photo-1439853949127-fa647821eba0 \
		photo-1497436072909-60f360e1d4b1 \
		photo-1500534314209-a25ddb2bd429
	local wanted="$(( ($(date '+%s') / 43200) % $# + 1 ))"
	local index=1
	for photo_id in "$@"; do
		if [ "$index" -eq "$wanted" ]; then
			echo "https://images.unsplash.com/${photo_id}?auto=format&fit=crop&w=1920&h=1080&q=85"
			return 0
		fi
		index="$((index + 1))"
	done
}

unsplash_api() {
	local collection_id="$1"
	local query="orientation=landscape&query=wallpaper"
	[ -z "$collection_id" ] || query="orientation=landscape&collections=${collection_id}"
	valid_key "$UNSPLASH_KEY" || return 1
	wget -T10 -qO- \
		"https://api.unsplash.com/photos/random?client_id=${UNSPLASH_KEY}&${query}" |
		jsonfilter -qe '@.urls.full'
}

bing_pic() {
	local host="$1" market="$2" picpath
	picpath="$(wget -T5 -qO- \
		"https://${host}/HPImageArchive.aspx?format=js&idx=0&n=1&mkt=${market}" |
		jsonfilter -qe '@.images[0].url' |
		sed 's/1920x1080/UHD/g')"
	[ -n "$picpath" ] || return 1
	printf 'https://%s%s\n' "$host" "$picpath"
}

valid_pic_url() {
	case "$1" in
		https://cn.bing.com/*|https://www.bing.com/*|https://images.unsplash.com/*)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

fetch_pic_url() {
	case "$WEB_PIC_SRC" in
	bing)
		bing_pic www.bing.com en-US
		;;
	bing_cn)
		# cn.bing.com is served inside mainland China and needs no API key.
		# A global Bing request is the immediate fallback; the cache remains the
		# final fallback in try_update().
		bing_pic cn.bing.com zh-CN || bing_pic www.bing.com zh-CN
		;;
	unsplash)
		unsplash_api || unsplash_fallback
		;;
	unsplash_*)
		local collection_id="${WEB_PIC_SRC#unsplash_}"
		unsplash_api "$collection_id" || unsplash_fallback
		;;
	esac
}

try_update() {
	local lock_status picurl update_status release_status
	init_runtime || return 1
	if acquire_lock; then
		lock_status=0
	else
		lock_status="$?"
	fi
	case "$lock_status" in
		0)
			trap 'release_lock >/dev/null 2>&1 || true' EXIT
			trap 'release_lock >/dev/null 2>&1 || true; exit 1' HUP INT TERM
			update_status=0
			# Do not leak the lock descriptor to wget/jsonfilter descendants.
			# If this rpcd process is SIGKILLed or OOM-killed, the kernel can
			# therefore release the lock immediately.
			picurl="$(
				# A redirection attached to a shell function may make the shell
				# retain a private copy so it can restore fd 9 afterwards. Close
				# it permanently inside the command-substitution process instead.
				exec 9>&-
				fetch_pic_url
			)"
			if valid_pic_url "$picurl"; then
				if write_cache "$picurl"; then
					printf '%s\n' "$picurl"
				else
					update_status=1
				fi
			elif ! read_cache; then
				write_cache '' || update_status=1
			fi
			if release_lock; then
				release_status=0
			else
				release_status=1
			fi
			trap - EXIT HUP INT TERM
			[ "$update_status" -eq 0 ] && [ "$release_status" -eq 0 ]
			;;
		1)
			# Another request owns the kernel lock. Serving only a
			# validated cache preserves the non-blocking RPC behaviour.
			read_cache || true
			;;
		*)
			# An unexpected lock type is unsafe, not a normal busy state.
			return 1
			;;
	esac
}

case "$1" in
"list")
	json_init
	json_add_object "get_url"
	json_close_object
	json_dump
	json_cleanup
	;;
"call")
	case "$2" in
	"get_url")
		read -r input
		if ! init_runtime; then
			echo '{ "url": "" }'
			return 1
		fi
		if path_exists "$CACHE"; then
			idle_t="$(cache_age)" || {
				echo '{ "url": "" }'
				return 1
			}
			if [ -s "$CACHE" ]; then
				if [ "$idle_t" -le "43200" ]; then
					json_init
					json_add_string "url" "$(read_cache)"
					json_dump
					json_cleanup
					return 0
				fi
			else
				if [ "$idle_t" -le 120 ]; then
					echo '{ "url": "" }'
					return 1
				fi
			fi
		fi

		json_init
		json_add_string "url" "$(try_update)"
		json_dump
		json_cleanup
		return 0
		;;
	esac
	;;
esac
